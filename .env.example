# MongoDB Atlas connection (never commit the real .env)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Admin boundary: quando definida, endpoints administrativos (model swap, resets,
# aprovação de denylist, area=all nos logs) exigem o header X-Admin-Key com este
# valor. Sem ela o PoV roda em modo demo aberto (warning no log).
# ADMIN_API_KEY=troque-por-um-segredo-forte

# Rate limit por identidade (requisições/minuto) nos endpoints que chamam LLM
# RATE_LIMIT_PER_MINUTE=30

# Origens CORS permitidas (CSV) — defina ao servir atrás de um domínio real
# CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183

# Deadline do turno do agente (s) e teto de tokens por turno
# AGENT_TURN_TIMEOUT_SECONDS=120
# AGENT_MAX_TURN_TOKENS=60000

# Micro-cache do model_config (s). 0 = leitura a cada request (regra da demo)
# CONFIG_CACHE_SECONDS=0

# JWT: segredo de assinatura (sem ela: segredo efêmero por processo) e modo
# estrito (1 = request sem Bearer válido é rejeitada; 0 = fallback demo)
# JWT_SECRET=troque-por-um-segredo-forte
# AUTH_REQUIRED=0
# Em qualquer ambiente não local:
# ENVIRONMENT=production
# AUTH_REQUIRED=1
# DEMO_TOKEN_ISSUANCE_ENABLED=0

# Logs em JSON estruturado (agregáveis por coletor) — 1 liga
# LOG_JSON=0
# Provider resilience
ANTHROPIC_TIMEOUT_SECONDS=45
ANTHROPIC_MAX_RETRIES=2

# Pool de sessões MCP: N subprocessos independentes do MongoDB MCP Server, com
# round-robin entre chamadas. Uma sessão só serializa toda call_tool concorrente.
# MCP_POOL_SIZE=3

# Versão pinada do pacote npm mongodb-mcp-server (reprodutibilidade: sem pin, a
# mesma PoV roda com versões diferentes em dev/demo/apresentação)
# MCP_SERVER_VERSION=2.1.0

# Pool de conexões MongoDB (driver) — número real de referência para
# dimensionamento de capacidade
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_IDLE_TIME_MS=30000

# Langfuse (trace do loop do agente). Sem as duas chaves, tracing.py vira
# no-op — a demo roda igual, só sem observability.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Gateway Grove (same credential for Anthropic and OpenAI protocols)
GROVE_API_KEY=
GROVE_ANTHROPIC_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic
GROVE_CHAT_COMPLETIONS_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1/chat/completions
GROVE_OPENAI_MODELS=["gpt-5.6-luna"]
# Historical blended estimates, USD per million total tokens; NOT invoice tariffs.
LLM_BLENDED_PRICES={"claude-haiku-4-5":2.40,"gpt-5.6-luna":0.38,"claude-sonnet-4-5":1.96,"claude-sonnet-5":2.43}

# Observabilidade de INFRA (pov-shared). off = sem spans (default, zero overhead).
# atlas = os spans do turno viram documentos em observability.spans NO MESMO CLUSTER
# — configuração, cache, memória, auditoria e agora tracing, todos como documento.
# TRACE_MASK_PII é forçado para 1 pelo código (backend/observability.py); spans
# carregam mensagem do cliente e resultado de ferramenta.
TRACE_SINK=off
# TRACE_DB=observability
# TRACE_COLLECTION=spans
# TRACE_TTL_DAYS=7
